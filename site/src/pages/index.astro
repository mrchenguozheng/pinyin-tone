---
import Layout from "../layouts/Layout.astro";
import { toPinyin } from "../common/functions";
import { NPM_LINK, GITHUB_LINK } from "../common/links";
import cases from "../common/cases.json";
import sitePackage from "../../package.json";

// The table below is not written here. It lives in ../common/cases.json, and
// test/test-cases-fixture.js reads that same file: one copy, two readers. The failure this
// prevents is the one that would cost this page its point — a second copy kept by hand that
// drifts from the copy the tests check.

type Expectation = string | undefined;

interface TestCase {
	id: string;
	input: string;
	/** Expected output of v1 — the 2.x root export. */
	v1?: Expectation;
	/** Expected output of v2 — the 2.x `pinyin-tone/v2` subpath. */
	v2?: Expectation;
	/** Expected output of v3 — `markTones` from 3.0. */
	v3?: Expectation;
	note?: string;
}

const tests = cases as TestCase[];

/**
 * One cell of the table, computed behind a try/catch.
 *
 * Every version call goes through here, at build time and again in the browser. A call that
 * throws would otherwise leave the cell blank — a library that dies on one input would look
 * like a library that returned an empty string, and the difference is the whole point of
 * this page. So the cell carries the message instead.
 */
interface Cell {
	text: string;
	/** An expectation is declared for this version on this row. */
	declared: boolean;
	/** Declared, and the output matched it. A cell with no expectation is never "broken". */
	matched: boolean;
	/** The call itself threw; `text` already holds the message. */
	threw: boolean;
}

const callCell = (expected: string | undefined, fn: () => string): Cell => {
	try {
		const out = fn();
		return {
			text: out,
			declared: expected !== undefined,
			matched: expected === undefined || out === expected,
			threw: false,
		};
	} catch (error) {
		const message = error instanceof Error ? error.message : String(error);
		return { text: `✗ 抛错: ${message}`, declared: expected !== undefined, matched: false, threw: true };
	}
};

const versions = ["v1", "v2", "v3"] as const;

const rows = tests.map((test) => ({
	...test,
	cells: {
		v1: callCell(test.v1, () => toPinyin.v1(test.input)),
		v2: callCell(test.v2, () => toPinyin.v2(test.input)),
		v3: callCell(test.v3, () => toPinyin.v3(test.input)),
	},
}));

// The page's claim is "these rows were actually run". A declared expectation that stops
// matching has to fail the build, not ship quietly as a cross nobody reads.
const mismatches = rows.flatMap((row) =>
	versions
		.filter((version) => row.cells[version].declared && !row.cells[version].matched)
		.map(
			(version) =>
				`#${row.id} ${version}: expected ${JSON.stringify(row[version])}, got ${JSON.stringify(row.cells[version].text)}`,
		),
);
if (mismatches.length) {
	throw new Error(
		`cases.json no longer matches the installed versions:\n  ${mismatches.join("\n  ")}`,
	);
}

// The options exist only in 3.0, and they have to reach the unspaced cell too: that cell is
// the same call with the spaces collapsed. When it stopped passing its arguments, ticking
// `strict` moved one cell and left the other alone — the page looked fine and was wrong.
// Assert it at build time so the failure is loud.
const optionChecks: Array<[string, string, string]> = [
	[toPinyin.v3("duang1 jui1", { strict: true }), "duang1 jui1", "v3 strict"],
	[toPinyin.v3Unspaced("duang1jui1", { strict: true }), "duang1jui1", "v3 unspaced strict"],
];
for (const [actual, expected, label] of optionChecks) {
	if (actual !== expected) {
		throw new Error(`${label}: expected ${JSON.stringify(expected)}, got ${JSON.stringify(actual)}`);
	}
}

// What the page actually runs, read from the file that decides it. v1 and v2 come from
// pinyin-tone@2.5.2 (the 2.x line's last release, `legacy` on npm), v3 from the aliased 3.0.x —
// both pinned to an exact version, because this page is a record of what those two releases do,
// not a mirror of `latest`. A caret here would let a later release rewrite the demonstration
// without anyone editing this file, which is how a "three generations" page quietly becomes
// "two generations and today".
//
// Read by import rather than by `readFileSync(new URL(...))`: the prerender step moves this
// frontmatter into a chunk under `dist/.prerender/chunks/`, so a URL relative to the source file
// resolves against the output directory instead — a path that only holds together by accident.
const siteDependencies = (sitePackage as { dependencies: Record<string, string> }).dependencies;
const pins = {
	v1v2: siteDependencies["pinyin-tone"],
	v3: (siteDependencies["pinyin-tone-v3"] ?? "").replace(/^npm:pinyin-tone@/, ""),
};
for (const [name, spec] of [
	["pinyin-tone", pins.v1v2],
	["pinyin-tone-v3", pins.v3],
] as const) {
	if (!/^[0-9]+\.[0-9]+\.[0-9]+$/.test(spec)) {
		throw new Error(
			`${name} must be pinned to an exact version — this page is a record of two specific releases — got ${JSON.stringify(spec)}`,
		);
	}
}

const installV3 = `npm install pinyin-tone`;

const usageV3 = `import { markTones } from "pinyin-tone";

markTones("chu1 yin1 wei4 lai2");      // "chū yīn wèi lái"
markTones("han4yu3pin1yin1");           // "hànyǔpīnyīn"
markTones("今天ni3hao3");                // "今天nǐhǎo"
markTones("jv1 ju1 ju:1");              // "jū jū jǖ"

// options arrived in 3.0: strict limits conversion to the 426 standard
// syllables, skip keeps all-caps codes such as M2 as written
markTones("duang1 jui1", { strict: true });        // "duang1 jui1"
markTones("M2 货币供应量", { skip: "M2" });          // "M2 货币供应量"`;

const usageV2 = `import toPinyinTones from "pinyin-tone";            // v1
import v2, { convertUnspacedPinyin } from "pinyin-tone/v2";

toPinyinTones("han4 yu3 pin1 yin1");       // "hàn yǔ pīn yīn"
v2("liou2 yuen2");                          // "lióu yuén"
convertUnspacedPinyin("han4yu3pin1yin1");   // "hànyǔpīnyīn"`;

const migrateRows: Array<[string, string]> = [
	[
		'import toPinyinTones from "pinyin-tone"',
		'import { markTones } from "pinyin-tone"',
	],
	['import v2 from "pinyin-tone/v2"', "merged into markTones"],
	[
		'import { convertUnspacedPinyin } from "pinyin-tone/v2"',
		'markTones(x).replace(/ /g, "")',
	],
	[
		'import { markSinglePinyinVowel } from "pinyin-tone"',
		"superseded by markTones + its options",
	],
	["pinyin-tone/v1 and splitUnspacedSyllables", "removed in 3.0"],
];

const examples = [
	"han4yu3pin1yin1",
	"今天ni3hao3",
	"Hao3",
	"liou2 yuen2",
	"jv1 ju1 ju:1",
	"lu:e4",
	"M2 A4 N3",
];
---

<Layout>
	<header class="hero">
		<h1>Pinyin Tone</h1>
		<p class="hero-tones" aria-hidden="true">hàn yǔ pīn yīn fāng àn</p>
		<p class="hero-sub">
			Numeric pinyin in, tone-marked pinyin out. Three generations of the same
			library, running live in your browser.
		</p>
		<p class="hero-lede">
			Type numeric pinyin such as <code>han4 yu3</code> or <code>han4yu3</code>
			and get standard accented pinyin: <code>hàn yǔ</code> or
			<code>hànyǔ</code>. This page runs
			<a href={NPM_LINK} target="_blank" rel="noreferrer">pinyin-tone</a> v1, v2
			and v3 against the same input, so the differences are visible rather than
			described.
		</p>
	</header>

	<h2>Which version is which</h2>
	<div class="card-grid">
		<div class="card">
			<div class="card-head">
				<span class="pill pill-v1">v1</span>
				<span class="card-title">The 2.x root export</span>
			</div>
			<code class="entry">import toPinyin from "pinyin-tone"</code>
			<p class="muted card-note">
				Pattern based; folds <code>liou</code> to <code>liu</code> and
				<code>yuen</code> to <code>yun</code>. Removed in 3.0.
			</p>
		</div>
		<div class="card">
			<div class="card-head">
				<span class="pill pill-v2">v2</span>
				<span class="card-title">The experimental subpath</span>
			</div>
			<code class="entry">import v2 from "pinyin-tone/v2"</code>
			<p class="muted card-note">
				Table based, keeps the full forms of the finals — and the
				implementation 3.0 is built from.
			</p>
		</div>
		<div class="card card-current">
			<div class="card-head">
				<span class="pill">v3</span>
				<span class="card-title">The 3.0 rewrite</span>
			</div>
			<code class="entry">import &#123; markTones &#125; from "pinyin-tone"</code>
			<p class="muted card-note">
				The current release, published as <code>latest</code>. Named export
				only — no default — plus the <code>strict</code> and
				<code>skip</code> options that 3.0 adds.
			</p>
		</div>
	</div>

	<p class="muted pin-note">
		This page runs <code>pinyin-tone@{pins.v1v2}</code> (v1 and v2 —
		the last release of the 2.x line, the <code>legacy</code> tag on npm) and
		<code>pinyin-tone@{pins.v3}</code> (v3). Both are pinned to an exact version
		in <code>site/package.json</code> — no <code>^</code>, no <code>~</code> — so
		the outputs below stay the outputs of those two releases: a new release
		changes the library, not this record. The build fails if either pin loosens.
	</p>

	<h2 id="try">Try it</h2>
	<div class="panel">
		<label class="input-label" for="input">
			Type numeric pinyin, or pick an example
		</label>
		<input
			id="input"
			type="text"
			placeholder="han4 yu3 pin1 yin1"
			value="han4 yu3 pin1 yin1"
			autocapitalize="off"
			autocomplete="off"
			spellcheck="false"
		/>
		<div class="examples">
			{
				examples.map((example) => (
					<button type="button" data-fill={example}>
						{example}
					</button>
				))
			}
		</div>

		<div class="opt-row">
			<label>
				<input id="strict" type="checkbox" />
				<span><code>strict</code> — only the 426 standard syllables <span class="muted">(3.0 only)</span></span>
			</label>
			<label class="skip-label">
				<span><code>skip</code> <span class="muted">(3.0 only)</span> —</span>
				<input id="skip" type="text" placeholder="M2, A4" value="M2, A4" />
			</label>
		</div>

		<p class="muted options-note">
			Both options belong to 3.0. v1 and 2.x's <code>/v2</code> take no options
			at all, so the two left-hand columns stay put whatever you tick here.
		</p>

		<div class="card-grid output-grid">
			<div class="card">
				<div class="card-head">
					<span class="pill pill-v1">v1</span>
					<span class="card-title">root export</span>
				</div>
				<div class="result" id="out-v1"></div>
				<div class="copy-row">
					<button type="button" class="copy-btn" data-copy="out-v1">
						Copy
					</button>
				</div>
			</div>
			<div class="card">
				<div class="card-head">
					<span class="pill pill-v2">v2</span>
					<span class="card-title">/v2 subpath</span>
				</div>
				<div class="result" id="out-v2"></div>
				<div class="copy-row">
					<button type="button" class="copy-btn" data-copy="out-v2">
						Copy
					</button>
				</div>
			</div>
			<div class="card card-current">
				<div class="card-head">
					<span class="pill">v3</span>
					<span class="card-title">markTones</span>
				</div>
				<div class="result" id="out-v3"></div>
				<div class="copy-row">
					<button type="button" class="copy-btn" data-copy="out-v3">
						Copy
					</button>
				</div>
			</div>
		</div>

		<div class="unspaced-grid">
			<div class="unspaced-cell">
				<div class="unspaced-label">
					<span>v3 unspaced</span>
					<button type="button" class="copy-btn" data-copy="out-v3-unspaced">
						Copy
					</button>
				</div>
				<code class="result result-small" id="out-v3-unspaced"></code>
			</div>
			<div class="unspaced-cell">
				<div class="unspaced-label">
					<span>v2 unspaced</span>
					<button type="button" class="copy-btn" data-copy="out-v2-unspaced">
						Copy
					</button>
				</div>
				<code class="result result-small" id="out-v2-unspaced"></code>
			</div>
		</div>

		<p class="muted footnote">
			3.0 dropped <code>convertUnspacedPinyin</code>: gluing the output is a
			call-site decision now, <code>markTones(x).replace(/ /g, "")</code>. The v1
			row is the only one that leaves <code>han4yu3</code> untouched — v1 has no
			way to cut it into syllables.
		</p>
	</div>

	<script>
		import { toPinyin } from "../common/functions";

		const input = document.querySelector<HTMLInputElement>("#input")!;
		const strict = document.querySelector<HTMLInputElement>("#strict")!;
		const skip = document.querySelector<HTMLInputElement>("#skip")!;

		const outV1 = document.querySelector<HTMLElement>("#out-v1")!;
		const outV2 = document.querySelector<HTMLElement>("#out-v2")!;
		const outV3 = document.querySelector<HTMLElement>("#out-v3")!;
		const outV3Unspaced =
			document.querySelector<HTMLElement>("#out-v3-unspaced")!;
		const outV2Unspaced =
			document.querySelector<HTMLElement>("#out-v2-unspaced")!;

		// One cell, one try/catch. A version that throws is reported inside that cell and the
		// other four keep working. Leaving the exception to escape `render()` would abort the
		// whole update and leave every cell showing the previous input's output — silently
		// wrong, which is worse than an error message next to the version that broke.
		const set = (element: HTMLElement, compute: () => string) => {
			try {
				element.textContent = compute();
				element.classList.remove("bad");
			} catch (error) {
				element.textContent = `✗ 抛错: ${error instanceof Error ? error.message : String(error)}`;
				element.classList.add("bad");
			}
		};

		const render = () => {
			const text = input.value;
			const skipCodes = skip.value
				.split(",")
				.map((code) => code.trim())
				.filter(Boolean);

			// 3.0 only — v1 and 2.x's /v2 predate both options, so they get no argument at all.
			const options = {
				strict: strict.checked,
				skip: skipCodes.length ? skipCodes : undefined,
			};

			set(outV1, () => toPinyin.v1(text));
			set(outV2, () => toPinyin.v2(text));
			set(outV3, () => toPinyin.v3(text, options));
			// The unspaced cell is the same call with the spaces collapsed, so it has to see
			// the same options — otherwise ticking strict moves one cell and not the other.
			set(outV3Unspaced, () => toPinyin.v3Unspaced(text, options));
			set(outV2Unspaced, () => toPinyin.convertUnspacedPinyin(text));
		};

		input.addEventListener("input", render);
		strict.addEventListener("change", render);
		skip.addEventListener("input", render);

		document.querySelectorAll<HTMLButtonElement>("[data-fill]").forEach((btn) => {
			btn.addEventListener("click", () => {
				input.value = btn.dataset.fill ?? "";
				render();
				input.focus();
			});
		});

		document
			.querySelectorAll<HTMLButtonElement>("[data-copy]")
			.forEach((btn) => {
				btn.addEventListener("click", async () => {
					const target = document.getElementById(btn.dataset.copy ?? "");
					if (!target) return;
					await navigator.clipboard.writeText(target.textContent ?? "");
					const label = btn.textContent;
					btn.textContent = "Copied";
					setTimeout(() => {
						btn.textContent = label;
					}, 1200);
				});
			});

		render();
	</script>

	<h2>Usage</h2>

	<h3>3.0 (current, the <code>latest</code> tag)</h3>
	<pre><code>{installV3}</code></pre>
	<pre><code>{usageV3}</code></pre>

	<h3>2.x (still published, under the <code>legacy</code> tag)</h3>
	<pre><code>{usageV2}</code></pre>

	<h3>Moving from 2.x to 3.0</h3>
	<table>
		<thead>
			<tr>
				<th>2.x</th>
				<th>3.0</th>
			</tr>
		</thead>
		<tbody>
			{
				migrateRows.map(([oldWay, newWay]) => (
					<tr>
						<td>
							<code>{oldWay}</code>
						</td>
						<td>
							<code>{newWay}</code>
						</td>
					</tr>
				))
			}
		</tbody>
	</table>

	<p class="muted">
		Nothing that converted correctly under 2.x changes silently: 3.0 has no
		default export, so an old <code>import toPinyin from "pinyin-tone"</code>
		fails loudly rather than returning <code>undefined</code>. See the
		<a href={GITHUB_LINK} target="_blank" rel="noreferrer">repository</a> for the
		full changelog.
	</p>

	<h2 id="tests">Test cases</h2>

	<p>
		Every row below is run at build time, from <code>site/src/common/cases.json</code>
		— the same file <code>test/test-cases-fixture.js</code> reads, so the table and
		the test suite cannot drift apart. A cell shows the output; a tick means it
		matches the value declared for that version. A mismatch fails the build rather
		than shipping as a cross, and a version that throws is reported in its own cell
		instead of blanking it.
	</p>

	<table>
		<thead>
			<tr>
				<th>#</th>
				<th>Input</th>
				<th>v1</th>
				<th>v2</th>
				<th>v3</th>
			</tr>
		</thead>
		<tbody>
			{
				rows.map((row) => (
					<tr>
						<td class="cell-id">{row.id}</td>
						<td>
							<code>{row.input}</code>
							{row.note && <div class="muted note">{row.note}</div>}
						</td>
						{
							versions.map((version) => {
								const cell = row.cells[version];
								return (
									<td>
										{cell.threw ? (
											<span class="bad">{cell.text}</span>
										) : (
											<>
												<code>{cell.text}</code>
												{cell.declared &&
													(cell.matched ? (
														<span class="ok"> ✓</span>
													) : (
														<span class="bad"> ✗</span>
													))}
											</>
										)}
									</td>
								);
							})
						}
					</tr>
				))
			}
		</tbody>
	</table>

	<p class="muted">
		Rows 13–17 carry no v1/v2 expectation on purpose: they are the inputs where
		3.0 behaves differently, and where 2.x returns something that is visibly
		wrong — a truncated syllable, or the input unchanged.
	</p>

	<h2>Licence</h2>
	<p>
		MIT · <a href={NPM_LINK} target="_blank" rel="noreferrer">NPM</a> ·
		<a href={GITHUB_LINK} target="_blank" rel="noreferrer">GitHub</a>
	</p>
</Layout>

<style>
	.hero {
		padding-top: 0.4rem;
	}

	.hero-tones {
		font-family: var(--sans);
		font-weight: 600;
		font-size: 1.15rem;
		letter-spacing: 0.22em;
		color: var(--accent);
		margin: 0 0 1rem;
		opacity: 0.9;
	}

	.entry {
		font-size: 0.8rem;
		align-self: flex-start;
		white-space: normal;
		word-break: break-all;
	}

	.card-note {
		font-size: 0.84rem;
		line-height: 1.5;
		margin: 0;
	}

	.pin-note {
		font-size: 0.85rem;
		line-height: 1.55;
		margin: 1rem 0 0;
	}

	.card-current {
		border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
		background: linear-gradient(
			180deg,
			color-mix(in srgb, var(--accent) 7%, var(--bg-soft)),
			var(--bg-soft)
		);
	}

	.pill-v1 {
		background: var(--muted);
	}

	.pill-v2 {
		background: #7c5cdb;
		color: #fff;
	}

	@media (prefers-color-scheme: dark) {
		.pill-v2 {
			color: #17131f;
		}
	}

	.input-label {
		display: block;
		font-size: 0.9rem;
		font-weight: 600;
		margin-bottom: 0.55rem;
	}

	.output-grid {
		margin-top: 1.5rem;
	}

	.unspaced-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.9rem;
		margin-top: 0.9rem;
	}

	.unspaced-cell {
		background: var(--bg-inset);
		border: 1px dashed var(--line-strong);
		border-radius: 10px;
		padding: 0.7rem 0.9rem;
	}

	.unspaced-label {
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-size: 0.78rem;
		font-weight: 650;
		color: var(--muted);
		margin-bottom: 0.3rem;
	}

	.result-small {
		font-size: 0.98rem;
		white-space: pre-wrap;
		word-break: break-word;
	}

	.options-note {
		font-size: 0.82rem;
		margin: 0.6rem 0 0;
	}

	.footnote {
		font-size: 0.85rem;
		margin-top: 1.2rem;
		margin-bottom: 0;
	}

	.cell-id {
		font-family: var(--mono);
		font-size: 0.8rem;
		color: var(--muted);
	}

	.note {
		font-size: 0.76rem;
		margin-top: 0.15rem;
		max-width: 24ch;
		line-height: 1.45;
	}

	.skip-label input {
		width: 180px;
	}

	@media (max-width: 720px) {
		.unspaced-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
