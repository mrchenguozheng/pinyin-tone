{
  "name": "pinyin-tone",
  "version": "2.5.2",
  "description": "A library for converting pinyin tone numbers into pinyin tone marks.",
  "main": "dist/index.cjs",
  "types": "index.d.ts",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./dist/index.cjs",
      "default": "./index.js"
    },
    "./v1": {
      "types": "./v1/index.d.ts",
      "import": "./v1/index.js",
      "require": "./dist/v1.cjs"
    },
    "./v2": {
      "types": "./v2/index.d.ts",
      "import": "./v2/index.js",
      "require": "./dist/v2.cjs"
    },
    "./workaround": {
      "types": "./workaround/index.d.ts",
      "import": "./workaround/index.js",
      "require": "./dist/workaround.cjs"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=14"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "v1",
    "v2",
    "workaround",
    "dist"
  ],
  "scripts": {
    "build:cjs": "node scripts/build-cjs.mjs",
    "pretest": "node scripts/build-cjs.mjs --check",
    "test": "mocha && tsc --noEmit && tsc -p tsconfig.types.json",
    "prepack": "node scripts/build-cjs.mjs --check",
    "pack:check": "node scripts/check-pack.mjs"
  },
  "keywords": [
    "pinyin",
    "mandarin",
    "tone",
    "chinese",
    "convert",
    "kanji",
    "hanzi",
    "hanyu"
  ],
  "author": "Futaba Isshiki",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrchenguozheng/pinyin-tone.git"
  },
  "homepage": "https://github.com/mrchenguozheng/pinyin-tone",
  "bugs": {
    "url": "https://github.com/mrchenguozheng/pinyin-tone/issues"
  },
  "devDependencies": {
    "chai": "^6.2.2",
    "mocha": "^12.0.3",
    "typescript": "^5.8.3"
  }
}
